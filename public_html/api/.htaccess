# API Security & Configuration

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Pass Authorization Header to PHP (CRITICAL for cPanel/Apache)
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# 2. Prevent Directory Listing (Security)
Options -Indexes

# 3. Block access to explicitly dangerous files only
<FilesMatch "\.(bak|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>
